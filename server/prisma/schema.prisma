generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Change to "postgresql" when connecting to Supabase / PostgreSQL
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  username    String    @unique
  password    String
  name        String
  role        String    @default("MERCHANT_STAFF") // SUPER_ADMIN | MERCHANT_MANAGER | MERCHANT_STAFF
  merchantId  String?
  merchant    Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  status      String    @default("Active") // Active | Inactive | Suspended
  permissions String?   // JSON string of permissions
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([username])
  @@index([email])
  @@index([merchantId])
}

model Merchant {
  id         String     @id @default(uuid())
  name       String
  email      String
  phone      String?
  address    String?
  logo         String?
  businessType String?
  status       String     @default("Active") // Active | Suspended
  features   String?    // JSON string of MerchantFeatures toggles (sidebar items + AI)
  branches   Branch[]
  products   Product[]
  categories Category[]
  offers     Offer[]
  users      User[]
  invoices   Invoice[]
  invoiceTemplate InvoiceTemplate?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([name])
}

model Branch {
  id                String            @id @default(uuid())
  merchantId        String
  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name              String
  address           String?
  imageUrl          String?
  qrToken           String            @unique
  qrStatus          String            @default("Active") // Active | Inactive
  categories        Category[]
  serviceCategories ServiceCategory[]
  scans             CustomerScan[]
  invoices          Invoice[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([qrToken])
  @@index([merchantId])
}

model Category {
  id         String    @id @default(uuid())
  merchantId String
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([merchantId])
  @@index([branchId])
}

model Product {
  id          String    @id @default(uuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name        String
  barcode     String
  price       Float
  stocks      Int       @default(0)
  description String?
  imageUrl    String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status      String    @default("Active") // Active | Inactive
  feeIds      String?   // JSON string array of Fee IDs applied
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([merchantId, barcode])
  @@index([barcode])
  @@index([merchantId])
}

model ServiceCategory {
  id          String        @id @default(uuid())
  name        String
  description String?
  branchId    String?
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status      String        @default("Active")
  services    ServiceItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([branchId])
}

model ServiceItem {
  id          String          @id @default(uuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String          @default("Active")
  subServices SubService[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
}

model SubService {
  id          String      @id @default(uuid())
  serviceId   String
  service     ServiceItem @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name        String
  price       Float       @default(0)
  description String?
  status      String      @default("Active")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([serviceId])
}

model ProductAddon {
  id              String   @id @default(uuid())
  name            String
  categoryTag     String
  price           Float    @default(0)
  applicableScope String   @default("ALL") // ALL | SPECIFIC
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CustomerScan {
  id          String   @id @default(uuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  barcode     String?
  productName String?
  price       Float?
  scannedAt   DateTime @default(now())
  userAgent   String?
  ipAddress   String?

  @@index([branchId])
  @@index([scannedAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  actorEmail  String
  actionType  String
  entityType  String
  entityId    String
  oldValues   String?  // JSON text
  newValues   String?  // JSON text
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Fee {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("PERCENTAGE") // PERCENTAGE | FIXED
  value       Float    @default(0)
  description String?
  status      String   @default("Active") // Active | Inactive
  merchantId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model InvoiceTemplate {
  id              String   @id @default(uuid())
  merchantId      String   @unique
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  templateName    String   @default("Standard Invoice")
  layoutStyle     String   @default("MODERN") // MODERN | CLASSIC | THERMAL_POS
  primaryColor    String   @default("#4F46E5")
  accentColor     String   @default("#10B981")
  businessName    String?
  logoUrl         String?
  showLogo        Boolean  @default(true)
  taxNumber       String?  // الرقم الضريبي
  commercialReg   String?  // السجل التجاري
  headerNotice    String?  // ترويسة الفاتورة
  footerNotice    String?  // شروط وأحكام / تذييل الفاتورة
  showQrCode      Boolean  @default(true) // Zatca/QR scan
  showTaxDetails  Boolean  @default(true)
  showBranchInfo  Boolean  @default(true)
  showCashierName Boolean  @default(true)
  paperSize       String   @default("A4") // A4 | 80MM
  fontFamily      String   @default("sans") // sans | serif | mono | cairo
  headerStyle     String   @default("BORDER_TOP") // BORDER_TOP | SOLID_BANNER | SUBTLE_TINT | MINIMAL
  tableStyle      String   @default("STRIPED") // STRIPED | BORDERED | MINIMAL | GRID
  borderRadius    String   @default("ROUNDED_MD") // ROUNDED_NONE | ROUNDED_MD | ROUNDED_LG
  watermarkText   String?  @default("PAID")
  showWatermark   Boolean  @default(false)
  qrPosition      String   @default("FOOTER_RIGHT") // HEADER_RIGHT | FOOTER_CENTER | FOOTER_RIGHT
  showBarcode        Boolean  @default(true)
  currencyPosition   String   @default("AFTER") // BEFORE | AFTER
  returnPolicyDays   Int      @default(14)      // Max days allowed for returns
  allowPartialReturn Boolean  @default(true)    // Allow returning individual items
  returnPolicyNotes  String?                    // Merchant return policy terms
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([merchantId])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique // e.g. INV-2026-0001
  merchantId      String
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerName    String?
  customerPhone   String?
  customerTaxNo   String?
  paymentMethod   String        @default("CASH") // CASH | CARD | ONLINE | QR_SCAN | INSTAPAY
  status          String        @default("PAID") // PAID | PARTIALLY_RETURNED | REFUNDED | PENDING | CANCELLED
  subtotal        Float         @default(0)
  taxTotal        Float         @default(0)
  feesTotal       Float         @default(0)
  discountTotal   Float         @default(0)
  grandTotal      Float         @default(0)
  refundedTotal   Float         @default(0)
  returnReason    String?
  returnedAt      DateTime?
  appliedFees     String?       // JSON text of applied fees snapshots
  items           InvoiceItem[]
  notes           String?
  issuedAt        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([merchantId])
  @@index([branchId])
  @@index([invoiceNumber])
  @@index([issuedAt])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  barcode     String?
  quantity    Int      @default(1)
  returnedQty Int      @default(0)
  unitPrice   Float    @default(0)
  totalPrice  Float    @default(0)
  feeIds      String?  // JSON text of fee IDs
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model Offer {
  id            String   @id @default(uuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  discountType  String   @default("PERCENTAGE") // PERCENTAGE | FIXED
  discountValue Float    @default(0)
  productIds    String?  // JSON string array of assigned Product IDs
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([merchantId])
  @@index([isActive])
}
